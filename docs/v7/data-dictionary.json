{
  "status": "agent default (Claude, 2026-09-25); internal field names only; learner-facing labels are Chris's call",
  "purpose": "One term per concept for every contract, script, and data file. The course catalog contract, anchoring, notes, and reader index must use the canonical names; aliases are read during migration only.",
  "rule": "Keep an existing name when it is already dominant; prefer the archived design name when the current one is cryptic.",
  "concepts": [
    {"concept": "book number", "canonical": "book", "type": "int 1-66 (Protestant order)", "aliases": [{"term": "book", "where": "data/bible.db verses, concordance.db entries, reader URL"}, {"term": "bookNumber", "where": ".src-archived CanonicalBook"}, {"term": "bn", "where": "public/library-data.js, bible.js"}, {"term": "ref[0]", "where": "public/data/crossref shards"}]},
    {"concept": "chapter", "canonical": "chapter", "type": "int", "aliases": [{"term": "chapter", "where": "bible.db, concordance.db, reader URL, archived PassageAddress"}, {"term": "ref[1]", "where": "crossref shards"}]},
    {"concept": "verse range", "canonical": "verseStart / verseEnd", "type": "int; verseEnd optional", "aliases": [{"term": "verseStart/verseEnd", "where": ".src-archived PassageAddress"}, {"term": "start/end", "where": "reader URL params"}, {"term": "verse", "where": "bible.db (single verse)"}, {"term": "ref[2]/ref[3]", "where": "crossref shards"}, {"term": "#v<n>", "where": "journal keys (incidental)"}]},
    {"concept": "structured Scripture address", "canonical": "PassageAddress {book, chapter, verseStart, verseEnd}", "aliases": [{"term": "PassageAddress", "where": ".src-archived schema"}, {"term": "[b,c,vs,ve]", "where": "crossref shards (compact serialization, keep for payload size)"}]},
    {"concept": "display reference text", "canonical": "reference", "type": "string, e.g. 'Genesis 1:26–31'", "aliases": [{"term": "reference", "where": "bible.db, concordance.db"}, {"term": "ref / reading", "where": "catalog lessons"}, {"term": "readingReferenceText", "where": ".src-archived CurriculumLesson"}]},
    {"concept": "authoring Scripture anchor", "canonical": "osis", "type": "string, e.g. 'John.3.16' or 'Matt.26.14-16'", "aliases": [{"term": "From Verse/To Verse", "where": "content/vendor/openbible"}]},
    {"concept": "list of Scripture references", "canonical": "scriptureRefs", "type": "PassageAddress[]", "aliases": [{"term": "scriptureRefs", "where": ".src-archived Claim"}, {"term": "passageRefs", "where": ".src-archived Interpretation"}, {"term": "refs", "where": "catalog topics"}, {"term": "extraReadings", "where": "catalog lessons"}]},
    {"concept": "primary reading", "canonical": "readingAddress", "type": "PassageAddress", "aliases": [{"term": "readingAddress", "where": ".src-archived CurriculumLesson"}, {"term": "reading / ref", "where": "catalog lessons (string)"}]},
    {"concept": "top-level curriculum division", "canonical": "moduleId", "type": "id", "aliases": [{"term": "courseId", "where": "catalog, structure.mjs, activities, questionThreads"}, {"term": "movementId", "where": ".src-archived CurriculumLesson"}], "note": "Decision curriculum-four-modules; learner-facing label still open"},
    {"concept": "unit", "canonical": "unitId", "type": "id", "aliases": [{"term": "unitId", "where": "catalog, structure.mjs, archived"}, {"term": "v6Unit / v4Unit / unit", "where": "catalog migration fields (retire)"}]},
    {"concept": "position within parent", "canonical": "sequence", "type": "int", "aliases": [{"term": "sequence", "where": "structure.mjs courses and units"}, {"term": "sequenceInUnit", "where": ".src-archived"}, {"term": "curriculumOrder / legacyOrder", "where": "catalog lessons (retire)"}]},
    {"concept": "lesson objective", "canonical": "objective", "aliases": [{"term": "objective", "where": "catalog, archived"}]},
    {"concept": "plain-language summary", "canonical": "plainSummary", "aliases": [{"term": "simple", "where": "catalog lessons"}, {"term": "plainSummary", "where": ".src-archived"}]},
    {"concept": "lesson checks", "canonical": "checks / reviewChecks", "aliases": [{"term": "challenges / reviewChallenges", "where": "catalog lessons"}, {"term": "checks / reviewChecks", "where": ".src-archived"}]},
    {"concept": "check type", "canonical": "kind", "aliases": [{"term": "kind", "where": "catalog challenges and topics"}]},
    {"concept": "check fields", "canonical": "prompt, items, options, answer, why, hint", "aliases": [{"term": "same names", "where": "catalog challenges"}]},
    {"concept": "reflection", "canonical": "reflection {prompt, modelResponse}", "aliases": [{"term": "reflect / model", "where": "catalog lessons"}, {"term": "reflection", "where": ".src-archived"}]},
    {"concept": "lesson section / step", "canonical": "section {id, title}", "aliases": [{"term": "stepCards / LessonStepCard", "where": ".src-archived"}], "note": "Section ids become outline anchors"},
    {"concept": "outline anchor", "canonical": "anchor", "type": "string '<kind>:<id>#<sectionId>' e.g. 'lesson:m3-passion#the-betrayal', 'topic:trinity'", "aliases": [{"term": "activityKey()", "where": "public/personal-study.js journal/notes keys"}]},
    {"concept": "apparatus entry (footnote / deeper)", "canonical": "apparatus", "type": "{id, anchor, scriptureRefs, kind, title, canonStatus, evidenceStatus, doctrinalStatus, sources}", "aliases": [{"term": "deeper / sources", "where": "catalog lessons"}, {"term": "apparatus {glossaryItemIds, translationVariantIds, disagreementIds, historicalEvidenceIds}", "where": ".src-archived"}]},
    {"concept": "canon status", "canonical": "canonStatus", "type": "enum canonical | deuterocanonical | extra-canonical"},
    {"concept": "evidence status", "canonical": "evidenceStatus", "type": "enum direct | strong | plausible | contested | speculative", "aliases": [{"term": "evidenceStatus", "where": ".src-archived knowledge model"}]},
    {"concept": "doctrinal status", "canonical": "doctrinalStatus", "type": "enum affirmed | bounded-inference | open | descriptive-only | outside-scope", "aliases": [{"term": "doctrinalStatus", "where": ".src-archived knowledge model"}]},
    {"concept": "claim / interpretation", "canonical": "Claim, Interpretation", "aliases": [{"term": "same", "where": ".src-archived knowledge model"}]},
    {"concept": "glossary term", "canonical": "glossary {id, term, definitions, occurrences}", "aliases": [{"term": "vocab (map term->definition)", "where": "catalog lessons"}, {"term": "glossaryItemIds", "where": ".src-archived apparatus"}]},
    {"concept": "topic", "canonical": "topic {id, kind, title, aliases, tags, answer, sections, scriptureRefs, related}", "aliases": [{"term": "refs", "where": "catalog topics"}]},
    {"concept": "question thread", "canonical": "questionThreadIds; touchpoint {moduleId, unitId, stage}", "aliases": [{"term": "courseId in touchpoints", "where": "structure.mjs"}]},
    {"concept": "activity", "canonical": "activity {id, type, unitId, moduleId, title, sourceId}", "aliases": [{"term": "courseId", "where": "catalog activities"}]},
    {"concept": "book profile", "canonical": "book {book, name, testament, category, categoryOrder, chaptersCount, hook, synopsis, traditionalAuthor, criticalAuthorDate, eraId, keyPeople, canonicalThreads}", "aliases": [{"term": "syn", "where": "library-data.js"}, {"term": "people", "where": "library-data.js"}, {"term": "threads", "where": "library-data.js"}, {"term": "who / when", "where": "library-data.js"}, {"term": "read", "where": "library-data.js (retired with Where to start)"}]},
    {"concept": "book category", "canonical": "category", "type": "enum law | othist | wisdom | major | minor | gospel | nthist | paul | general | apoc", "aliases": [{"term": "category", "where": "archived schema and library-data.js (already consistent)"}]},
    {"concept": "learner note", "canonical": "note {anchor, scriptureRefs, text, updatedAt, discussLater}", "aliases": [{"term": "state.notes[key] / state.journal[key] {text, updatedAt}", "where": "public/personal-study.js, public/db.js"}]},
    {"concept": "learner state sync", "canonical": "learner_state, learner_mutation", "aliases": [{"term": "same", "where": "worker/migrations (D1)"}]}
  ]
}
