{
  "name":"canonical-shelf-v6",
  "private":true,
  "type":"module",
  "scripts":{
    "migrate":"bun scripts/migrate-legacy.mjs && bun scripts/postprocess-v6.mjs",
    "validate":"bun scripts/validate.mjs",
