{
  "contract": "theme",
  "version": 7,
  "description": "Every themeable value. Shared values (type scale, line heights, spacing, motion, Bible category colors, layout measures) are set once. Each theme sets 14 color roles for light and dark (page; surface, raised and sunken surfaces; border; primary, secondary, and muted text; action and text on action for anything clickable; accent and text on accent for non-clickable emphasis; correct; incorrect), optional per-mode shadows, and its style (display, body, reading, and label fonts; small, medium, and large corners, which may be free-form; border weight and style; shadows; backdrop; surface and border filters; texture; illustration set). Derived colors are generated. fontSources are fetched at build time; fontImports are what the site loads. Contrast rules cover text and clickable controls (WCAG AA); borders and accents are decorative and not contrast-checked; translucent colors are measured as seen over the page. A theme may set a native mode used until the learner chooses light or dark.",
  "schema": {
    "type": "object",
    "props": {
      "shared": {
        "type": "object",
        "props": {
          "typeScale": {
            "type": "object",
            "props": {
              "caption": {
                "type": "length"
              },
              "small": {
                "type": "length"
              },
              "body": {
                "type": "length"
              },
              "lead": {
                "type": "length"
              },
              "h3": {
                "type": "length"
              },
              "h2": {
                "type": "length"
              },
              "h1": {
                "type": "length"
              }
            }
          },
          "lineHeights": {
            "type": "object",
            "props": {
              "tight": {
                "type": "number",
                "min": 1,
                "max": 2.4
              },
              "normal": {
                "type": "number",
                "min": 1,
                "max": 2.4
              },
              "reading": {
                "type": "number",
                "min": 1,
                "max": 2.4
              }
            }
          },
          "spacing": {
            "type": "object",
            "props": {
              "s1": {
                "type": "length"
              },
              "s2": {
                "type": "length"
              },
              "s3": {
                "type": "length"
              },
              "s4": {
                "type": "length"
              },
              "s5": {
                "type": "length"
              },
              "s6": {
                "type": "length"
              },
              "s7": {
                "type": "length"
              }
            }
          },
          "motion": {
            "type": "object",
            "props": {
              "fast": {
                "type": "duration"
              },
              "base": {
                "type": "duration"
              },
              "easing": {
                "type": "css-value"
              }
            }
          },
          "bibleCategories": {
            "type": "map",
            "of": {
              "type": "color"
            },
            "keyPattern": "^[a-z][a-z0-9-]*$",
            "minItems": 1
          },
          "measures": {
            "type": "map",
            "of": {
              "type": "css-value"
            },
            "keyPattern": "^[a-z][a-z0-9-]*$",
            "optional": true
          }
        }
      },
      "themes": {
        "type": "map",
        "keyPattern": "^[a-z][a-z0-9-]*$",
        "minItems": 1,
        "of": {
          "type": "object",
          "props": {
            "name": {
              "type": "text"
            },
            "description": {
              "type": "text"
            },
            "fontImports": {
              "type": "list",
              "of": {
                "type": "string",
                "pattern": "^(/[^\\s\"]+|https://[^\\s\"]+)$"
              },
              "optional": true
            },
            "style": {
              "type": "object",
              "props": {
                "fontDisplay": {
                  "type": "font"
                },
                "fontBody": {
                  "type": "font"
                },
                "fontLabel": {
                  "type": "font"
                },
                "radiusSmall": {
                  "type": "css-value"
                },
                "radiusLarge": {
                  "type": "css-value"
                },
                "borderWeight": {
                  "type": "length"
                },
                "shadowRaised": {
                  "type": "css-value"
                },
                "shadowOverlay": {
                  "type": "css-value"
                },
                "texture": {
                  "type": "css-value"
                },
                "illustrations": {
                  "type": "id"
                },
                "fontReading": {
                  "type": "font",
                  "optional": true
                },
                "borderStyle": {
                  "type": "enum",
                  "options": [
                    "solid",
                    "double",
                    "dashed"
                  ]
                },
                "backdrop": {
                  "type": "css-value",
                  "optional": true
                },
                "radiusMedium": {
                  "type": "css-value"
                },
                "surfaceFilter": {
                  "type": "css-value",
                  "optional": true
                },
                "borderFilter": {
                  "type": "css-value",
                  "optional": true
                }
              }
            },
            "modes": {
              "type": "object",
              "props": {
                "light": {
                  "type": "object",
                  "props": {
                    "page": {
                      "type": "color"
                    },
                    "surface": {
                      "type": "color"
                    },
                    "surfaceRaised": {
                      "type": "color"
                    },
                    "surfaceSunken": {
                      "type": "color"
                    },
                    "border": {
                      "type": "color"
                    },
                    "text": {
                      "type": "color"
                    },
                    "textSecondary": {
                      "type": "color"
                    },
                    "textMuted": {
                      "type": "color"
                    },
                    "action": {
                      "type": "color"
                    },
                    "onAction": {
                      "type": "color"
                    },
                    "accent": {
                      "type": "color"
                    },
                    "onAccent": {
                      "type": "color"
                    },
                    "correct": {
                      "type": "color"
                    },
                    "incorrect": {
                      "type": "color"
                    },
                    "shadowRaised": {
                      "type": "css-value",
                      "optional": true
                    },
                    "shadowOverlay": {
                      "type": "css-value",
                      "optional": true
                    }
                  }
                },
                "dark": {
                  "type": "object",
                  "props": {
                    "page": {
                      "type": "color"
                    },
                    "surface": {
                      "type": "color"
                    },
                    "surfaceRaised": {
                      "type": "color"
                    },
                    "surfaceSunken": {
                      "type": "color"
                    },
                    "border": {
                      "type": "color"
                    },
                    "text": {
                      "type": "color"
                    },
                    "textSecondary": {
                      "type": "color"
                    },
                    "textMuted": {
                      "type": "color"
                    },
                    "action": {
                      "type": "color"
                    },
                    "onAction": {
                      "type": "color"
                    },
                    "accent": {
                      "type": "color"
                    },
                    "onAccent": {
                      "type": "color"
                    },
                    "correct": {
                      "type": "color"
                    },
                    "incorrect": {
                      "type": "color"
                    },
                    "shadowRaised": {
                      "type": "css-value",
                      "optional": true
                    },
                    "shadowOverlay": {
                      "type": "css-value",
                      "optional": true
                    }
                  }
                }
              }
            },
            "hidden": {
              "type": "bool",
              "optional": true
            },
            "fontSources": {
              "type": "list",
              "of": {
                "type": "url"
              },
              "optional": true
            },
            "nativeMode": {
              "type": "enum",
              "options": [
                "light",
                "dark"
              ],
              "optional": true
            }
          }
        }
      },
      "default": {
        "type": "object",
        "props": {
          "theme": {
            "type": "id"
          },
          "mode": {
            "type": "enum",
            "options": [
              "light",
              "dark",
              "system"
            ]
          }
        }
      },
      "aliases": {
        "type": "map",
        "of": {
          "type": "css-value"
        },
        "keyPattern": "^[a-z][a-z0-9-]*$",
        "optional": true
      }
    }
  },
  "checks": [
    {
      "rule": "keyOf",
      "key": "default.theme",
      "map": "themes"
    },
    {
      "rule": "themeContrast",
      "pairs": "$fixed",
      "fixedPairs": [
        {
          "fg": "text",
          "bg": "page",
          "min": 4.5
        },
        {
          "fg": "text",
          "bg": "surface",
          "min": 4.5
        },
        {
          "fg": "text",
          "bg": "surfaceRaised",
          "min": 4.5
        },
        {
          "fg": "text",
          "bg": "surfaceSunken",
          "min": 4.5
        },
        {
          "fg": "textSecondary",
          "bg": "surface",
          "min": 4.5
        },
        {
          "fg": "textSecondary",
          "bg": "page",
          "min": 4.5
        },
        {
          "fg": "textMuted",
          "bg": "surface",
          "min": 3
        },
        {
          "fg": "onAction",
          "bg": "action",
          "min": 4.5
        },
        {
          "fg": "action",
          "bg": "surface",
          "min": 3
        },
        {
          "fg": "onAccent",
          "bg": "accent",
          "min": 4.5
        },
        {
          "fg": "correct",
          "bg": "surface",
          "min": 3
        },
        {
          "fg": "incorrect",
          "bg": "surface",
          "min": 3
        }
      ],
      "maps": "themes.*.modes.*"
    }
  ],
  "outputs": {
    "css": {
      "target": "css",
      "view": "theme-vars",
      "path": "public/theme.css"
    },
    "list": {
      "target": "js",
      "view": "theme-list",
      "path": "public/theme-list.js"
    }
  }
}
