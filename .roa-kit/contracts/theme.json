{
  "contract": "theme",
  "version": 1,
  "description": "Every themeable value on the site. Shared values (type scale, line heights, spacing, motion, Bible category colors) are set once; each theme sets 10 color roles for light and dark plus its style (fonts, corners, border weight, shadows, texture, illustration set). Hover, subtle, selection, disabled, and focus colors are derived, never authored. aliases maps older variable names onto roles during migration.",
  "schema": {
    "type": "object",
    "props": {
      "shared": {
        "type": "object",
        "props": {
          "typeScale": {
            "type": "object",
            "props": {
              "caption": {
                "type": "length"
              },
              "small": {
                "type": "length"
              },
              "body": {
                "type": "length"
              },
              "lead": {
                "type": "length"
              },
              "h3": {
                "type": "length"
              },
              "h2": {
                "type": "length"
              },
              "h1": {
                "type": "length"
              }
            }
          },
          "lineHeights": {
            "type": "object",
            "props": {
              "tight": {
                "type": "number",
                "min": 1,
                "max": 2.4
              },
              "normal": {
                "type": "number",
                "min": 1,
                "max": 2.4
              },
              "reading": {
                "type": "number",
                "min": 1,
                "max": 2.4
              }
            }
          },
          "spacing": {
            "type": "object",
            "props": {
              "s1": {
                "type": "length"
              },
              "s2": {
                "type": "length"
              },
              "s3": {
                "type": "length"
              },
              "s4": {
                "type": "length"
              },
              "s5": {
                "type": "length"
              },
              "s6": {
                "type": "length"
              },
              "s7": {
                "type": "length"
              }
            }
          },
          "motion": {
            "type": "object",
            "props": {
              "fast": {
                "type": "duration"
              },
              "base": {
                "type": "duration"
              },
              "easing": {
                "type": "css-value"
              }
            }
          },
          "bibleCategories": {
            "type": "map",
            "of": {
              "type": "color"
            },
            "keyPattern": "^[a-z][a-z0-9-]*$",
            "minItems": 1
          }
        }
      },
      "themes": {
        "type": "map",
        "keyPattern": "^[a-z][a-z0-9-]*$",
        "minItems": 1,
        "of": {
          "type": "object",
          "props": {
            "name": {
              "type": "text"
            },
            "description": {
              "type": "text"
            },
            "fontImports": {
              "type": "list",
              "of": {
                "type": "url"
              },
              "optional": true
            },
            "style": {
              "type": "object",
              "props": {
                "fontDisplay": {
                  "type": "font"
                },
                "fontBody": {
                  "type": "font"
                },
                "fontLabel": {
                  "type": "font"
                },
                "radiusSmall": {
                  "type": "length"
                },
                "radiusLarge": {
                  "type": "length"
                },
                "borderWeight": {
                  "type": "length"
                },
                "shadowRaised": {
                  "type": "css-value"
                },
                "shadowOverlay": {
                  "type": "css-value"
                },
                "texture": {
                  "type": "css-value"
                },
                "illustrations": {
                  "type": "id"
                }
              }
            },
            "modes": {
              "type": "object",
              "props": {
                "light": {
                  "type": "object",
                  "props": {
                    "page": {
                      "type": "color"
                    },
                    "surface": {
                      "type": "color"
                    },
                    "surfaceSunken": {
                      "type": "color"
                    },
                    "border": {
                      "type": "color"
                    },
                    "text": {
                      "type": "color"
                    },
                    "textMuted": {
                      "type": "color"
                    },
                    "action": {
                      "type": "color"
                    },
                    "onAction": {
                      "type": "color"
                    },
                    "correct": {
                      "type": "color"
                    },
                    "incorrect": {
                      "type": "color"
                    }
                  }
                },
                "dark": {
                  "type": "object",
                  "props": {
                    "page": {
                      "type": "color"
                    },
                    "surface": {
                      "type": "color"
                    },
                    "surfaceSunken": {
                      "type": "color"
                    },
                    "border": {
                      "type": "color"
                    },
                    "text": {
                      "type": "color"
                    },
                    "textMuted": {
                      "type": "color"
                    },
                    "action": {
                      "type": "color"
                    },
                    "onAction": {
                      "type": "color"
                    },
                    "correct": {
                      "type": "color"
                    },
                    "incorrect": {
                      "type": "color"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "default": {
        "type": "object",
        "props": {
          "theme": {
            "type": "id"
          },
          "mode": {
            "type": "enum",
            "options": [
              "light",
              "dark",
              "system"
            ]
          }
        }
      },
      "aliases": {
        "type": "map",
        "of": {
          "type": "css-value"
        },
        "keyPattern": "^[a-z][a-z0-9-]*$",
        "optional": true
      }
    }
  },
  "checks": [
    {
      "rule": "keyOf",
      "key": "default.theme",
      "map": "themes"
    },
    {
      "rule": "themeContrast",
      "pairs": "$fixed",
      "fixedPairs": [
        {
          "fg": "text",
          "bg": "page",
          "min": 4.5
        },
        {
          "fg": "text",
          "bg": "surface",
          "min": 4.5
        },
        {
          "fg": "text",
          "bg": "surfaceSunken",
          "min": 4.5
        },
        {
          "fg": "textMuted",
          "bg": "surface",
          "min": 4.5
        },
        {
          "fg": "onAction",
          "bg": "action",
          "min": 4.5
        },
        {
          "fg": "action",
          "bg": "surface",
          "min": 3
        },
        {
          "fg": "correct",
          "bg": "surface",
          "min": 3
        },
        {
          "fg": "incorrect",
          "bg": "surface",
          "min": 3
        },
        {
          "fg": "border",
          "bg": "surface",
          "min": 1.3
        }
      ],
      "maps": "themes.*.modes.*"
    }
  ],
  "outputs": {
    "css": {
      "target": "css",
      "view": "theme-vars",
      "path": "public/theme.css"
    }
  }
}
