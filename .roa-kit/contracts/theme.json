{
  "contract": "theme",
  "version": 11,
  "description": "Every themeable value. Shared values (type scale, line heights, spacing, motion, layout measures, stacking layers) are set once. Each theme sets color roles for light and dark (page; surface, raised, sunken, and subtle surfaces; scripture bed; border; primary, secondary, and muted text; action and text on action for anything clickable; accent and text on accent for non-clickable emphasis; note marker; selection; correct; incorrect; edge tabs for theologian and notes; chat surface and user bubble; dim overlay; four highlight colors {yellow, green, blue, rose}; nine Bible category group colors {law, othist, wisdom, major, minor, gospel, paul, general, apoc}), style (display, body, reading, and label fonts; corner radius scale including chip, control, card, frame; border weight and style; shadows including card, frame, overlay; backdrop; surface and border filters; texture; illustration set), and optional per-mode shadows and ornaments. Derived colors are generated. fontSources are fetched at build time; fontImports are what the site loads. Contrast rules cover text and clickable controls (WCAG AA); borders and accents are decorative and not contrast-checked; translucent colors are measured as seen over the page. A theme may set a native mode used until the learner chooses light or dark. Shared fonts (serif, sans, mono) are defined once; themes choose among them by reference, so a theme cannot introduce another font. Ornaments are up to six decorative colors per mode that let a theme be polychrome or near-monochrome. Shelf roles (wood and iron) color the Shelf home bookshelf: planks, support blocks and bookends; they are decorative and not contrast-checked. The radius scale also includes bar (progress bars) and marker (tooltips, step markers).",
  "schema": {
    "type": "object",
    "props": {
      "shared": {
        "type": "object",
        "props": {
          "typeScale": {
            "type": "object",
            "props": {
              "caption": {
                "type": "length"
              },
              "small": {
                "type": "length"
              },
              "body": {
                "type": "length"
              },
              "lead": {
                "type": "length"
              },
              "h3": {
                "type": "length"
              },
              "h2": {
                "type": "length"
              },
              "h1": {
                "type": "length"
              }
            }
          },
          "lineHeights": {
            "type": "object",
            "props": {
              "tight": {
                "type": "number",
                "min": 1,
                "max": 2.4
              },
              "normal": {
                "type": "number",
                "min": 1,
                "max": 2.4
              },
              "reading": {
                "type": "number",
                "min": 1,
                "max": 2.4
              }
            }
          },
          "spacing": {
            "type": "object",
            "props": {
              "s1": {
                "type": "length"
              },
              "s2": {
                "type": "length"
              },
              "s3": {
                "type": "length"
              },
              "s4": {
                "type": "length"
              },
              "s5": {
                "type": "length"
              },
              "s6": {
                "type": "length"
              },
              "s7": {
                "type": "length"
              }
            }
          },
          "motion": {
            "type": "object",
            "props": {
              "fast": {
                "type": "duration"
              },
              "base": {
                "type": "duration"
              },
              "easing": {
                "type": "css-value"
              }
            }
          },
          "layers": {
            "type": "object",
            "props": {
              "nav": {
                "type": "int",
                "min": 0
              },
              "edgeTabs": {
                "type": "int",
                "min": 0
              },
              "popups": {
                "type": "int",
                "min": 0
              },
              "dimOverlay": {
                "type": "int",
                "min": 0
              },
              "theologian": {
                "type": "int",
                "min": 0
              }
            }
          },
          "measures": {
            "type": "map",
            "of": {
              "type": "css-value"
            },
            "keyPattern": "^[a-z][a-z0-9-]*$",
            "optional": true
          },
          "fonts": {
            "type": "object",
            "props": {
              "serif": {
                "type": "font"
              },
              "sans": {
                "type": "font"
              },
              "mono": {
                "type": "font"
              }
            }
          }
        }
      },
      "themes": {
        "type": "map",
        "keyPattern": "^[a-z][a-z0-9-]*$",
        "minItems": 1,
        "of": {
          "type": "object",
