{
  "language": "css",
  "extension": ".css",
  "header": "/* GENERATED by project-roa-kit from .roa/values/{{contract}}.json \u2014 do not edit. Change values with: node .roa-kit/roa.mjs set {{contract}}.<path> <value> */\n",
  "templates": {
    "vars": ":root {\n{{#each vars}}  {{name}}: {{value}};\n{{/each}}}\n",
    "themed-vars": ":root {\n{{#each base}}  {{name}}: {{value}};\n{{/each}}}\n{{#each blocks}}\n/* {{comment}} */\n{{selectorText}} {\n{{#each vars}}  {{name}}: {{value}};\n{{/each}}}\n{{/each}}",
    "layout": ":root {\n{{#each vars}}  {{name}}: {{value}};\n{{/each}}}\n{{#each media}}\n/* {{label}} */\n{{open}}{{#each rules}}{{indent}}{{selector}} { {{body}} }\n{{/each}}{{close}}{{/each}}"
  }
}
