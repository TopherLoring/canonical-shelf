{
  "contract": "design-tokens",
  "version": 1,
  "description": "Visual tokens: base fonts, spacing, radii, shadows, and colors on :root, plus named themes with light and dark modes. Variable names are the map keys (emitted as --<key>).",
  "schema": {
    "type": "object",
    "props": {
      "base": {
        "type": "object",
        "props": {
          "fonts": {
            "type": "map",
            "of": {
              "type": "font"
            },
            "keyPattern": "^[a-z][a-z0-9-]*$",
            "optional": true
          },
          "lengths": {
            "type": "map",
            "of": {
              "type": "length"
            },
            "keyPattern": "^[a-z][a-z0-9-]*$",
            "optional": true
          },
          "colors": {
            "type": "map",
            "of": {
              "type": "color"
            },
            "keyPattern": "^[a-z][a-z0-9-]*$",
            "optional": true
          },
          "durations": {
            "type": "map",
            "of": {
              "type": "duration"
            },
            "keyPattern": "^[a-z][a-z0-9-]*$",
            "optional": true
          },
          "values": {
            "type": "map",
            "of": {
              "type": "css-value"
            },
            "keyPattern": "^[a-z][a-z0-9-]*$",
            "optional": true
          }
        }
      },
      "themes": {
        "type": "map",
        "keyPattern": "^[a-z][a-z0-9-]*$",
        "minItems": 1,
        "of": {
          "type": "object",
          "props": {
            "name": {
              "type": "text"
            },
            "aliases": {
              "type": "list",
              "of": {
                "type": "id"
              },
              "unique": true,
              "optional": true
            },
            "modes": {
              "type": "object",
              "props": {
                "light": {
                  "type": "map",
                  "of": {
                    "type": "css-value"
                  },
                  "keyPattern": "^[a-z][a-z0-9-]*$",
                  "minItems": 1
                },
                "dark": {
                  "type": "map",
                  "of": {
                    "type": "css-value"
                  },
                  "keyPattern": "^[a-z][a-z0-9-]*$",
                  "minItems": 1
                }
              }
            }
          }
        }
      },
      "default": {
        "type": "object",
        "props": {
          "theme": {
            "type": "id"
          },
          "mode": {
            "type": "enum",
            "options": [
              "light",
              "dark"
            ]
          }
        }
      },
      "contrastPairs": {
        "type": "list",
        "optional": true,
        "of": {
          "type": "object",
          "props": {
            "fg": {
              "type": "id"
            },
            "bg": {
              "type": "id"
            },
            "min": {
              "type": "number",
              "min": 1,
              "max": 21
            }
          }
        }
      }
    }
  },
  "checks": [
    {
      "rule": "uniformKeys",
      "maps": "themes.*.modes.*"
    },
    {
      "rule": "keyOf",
      "key": "default.theme",
      "map": "themes"
    },
    {
      "rule": "themeContrast",
      "pairs": "contrastPairs",
      "maps": "themes.*.modes.*"
    }
  ],
  "outputs": {
    "css": {
      "target": "css",
      "view": "themed-vars",
      "path": "public/design-tokens.css"
    }
  }
}
