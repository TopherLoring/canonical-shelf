{
  "base": {
    "fonts": {
      "ref-font-serif": "Cambria,Charter,Georgia,'Times New Roman',serif",
      "ref-font-mono": "ui-monospace,'Cascadia Mono','SF Mono',Menlo,Consolas,monospace"
    },
    "lengths": {
      "measure-reading": "72ch",
      "theme-radius": "15px",
      "control-radius": "7px",
      "theme-rule-width": "1px",
      "space-xs": ".5rem",
      "space-sm": ".75rem",
      "space-md": "1rem",
      "space-lg": "1.5rem",
      "space-xl": "2rem",
      "space-2xl": "3rem",
      "home-shelf-height": "111px",
      "home-shelf-depth": "10px"
    },
    "colors": {
