    },
    "values": {
      "ref-font-sans": "ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif",
      "font-body": "var(--ref-font-sans)",
      "font-reading": "var(--ref-font-serif)",
      "font-display": "var(--ref-font-serif)",
      "font-meta": "var(--ref-font-mono)",
      "theme-shadow": "0 18px 48px #0000001a",
      "theme-soft-shadow": "0 8px 24px #0000000d",
      "button-border": "var(--color-text-primary)",
      "button-bg": "transparent",
      "button-text": "var(--color-text-primary)",
      "button-primary-bg": "var(--chrome)",
      "nav-active-border": "var(--color-gilt)",
      "guide-bg": "var(--chrome-2)",
      "guide-shadow": "0 22px 58px #0005",
      "notice-border": "var(--color-accent-primary)",
      "notice-bg": "color-mix(in srgb,var(--color-surface-raised) 82%,transparent)",
      "progress-track": "var(--color-surface-subtle)",
      "progress-fill": "var(--color-accent-primary)",
      "study-chrome": "var(--color-surface-raised)",
      "study-chrome-2": "var(--color-surface-subtle)",
      "study-chrome-text": "var(--color-text-primary)",
      "study-chrome-muted": "var(--color-text-secondary)",
      "study-folio": "var(--color-surface-raised)",
      "study-rule": "var(--color-border-default)",
      "study-accent": "var(--color-accent-primary)",
      "study-nav-bg": "var(--color-surface-raised)"
    }
