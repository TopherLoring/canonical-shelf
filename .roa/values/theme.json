          "correct": "#1f6b3a",
          "incorrect": "#a3262e"
        },
        "dark": {
          "page": "#15171a",
          "surface": "#1f2226",
          "surfaceSunken": "#1b1d20",
          "border": "#4a4f57",
          "text": "#f5f6f8",
