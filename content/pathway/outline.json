{
  "pathway": "The Canonical Understanding Pathway",
  "status": "Module 1 goals and outcomes approved by Chris 2026-10-01; lessons authored in the final format: begin, c1-questions-first, c1-library-groups, c1-reading-kinds",
  "goals": [
    {
      "id": "m1.g1",
      "module": "m1",
      "text": "Know what Christianity claims at its center, and know that you can learn it before deciding whether you believe it."
    },
    {
      "id": "m1.g2",
      "module": "m1",
      "text": "Know what the Bible is and find your way around it."
    },
    {
      "id": "m1.g3",
      "module": "m1",
      "text": "Read any passage by first recognizing what kind of writing it is and what it claims."
    }
  ],
  "outcomes": [
    {
      "id": "m1.o1",
      "goal": "m1.g1",
      "text": "Put the proclamation Paul recalls in 1 Corinthians 15:1–5 into your own words, in its order."
    },
    {
      "id": "m1.o2",
      "goal": "m1.g1",
      "text": "Explain the difference between understanding a claim and agreeing with it."
    },
    {
      "id": "m1.o3",
      "goal": "m1.g1",
      "text": "Define gospel, Christ, and resurrection in plain words."
    },
    {
      "id": "m1.o4",
      "goal": "m1.g1",
      "text": "Hold a question provisionally while you build the knowledge to answer it well."
    },
    {
      "id": "m1.o5",
      "goal": "m1.g2",
      "text": "Name the nine groups of books and what each contains."
    },
    {
      "id": "m1.o6",
      "goal": "m1.g3",
      "text": "Identify the kind of writing in a passage and the kind of claim it makes."
    }
  ],
